# ── Platform ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=research-platform
PLATFORM_ENV=development
PLATFORM_DOMAIN=research.example.com
PLATFORM_ADMIN_TOKEN=change-me-long-random-string
REVIEW_BASE_URL=http://10.66.66.1:8001

# ── Postgres (single instance, per-tenant databases) ─────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=platform_meta

# ── Redis (single instance, per-tenant DB index) ─────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ── LLM providers (API-only; no local models) ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Demo tenant (working stub) ─────────────────────────────────────────────────
DEMO_TENANT_ID=demo
DEMO_TELEGRAM_BOT_TOKEN=
DEMO_TELEGRAM_ALLOWED_USER_IDS=123456789
DEMO_TELEGRAM_MODE=polling

# ── MEV tenant ─────────────────────────────────────────────────────────────────
MEV_TENANT_ID=mev
MEV_TELEGRAM_BOT_TOKEN=
MEV_TELEGRAM_ALLOWED_USER_IDS=
MEV_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Anomaly tenant ─────────────────────────────────────────────────────────────
ANOMALY_TENANT_ID=anomaly
ANOMALY_TELEGRAM_BOT_TOKEN=
ANOMALY_TELEGRAM_ALLOWED_USER_IDS=
ANOMALY_ETH_RPC_URL=

# ── Collective tenant ──────────────────────────────────────────────────────────
# Telegram vars here; GitHub publish creds go in secrets/collective/collective.env
COLLECTIVE_TENANT_ID=collective
COLLECTIVE_TELEGRAM_BOT_TOKEN=
COLLECTIVE_TELEGRAM_ALLOWED_USER_IDS=

# Exclude collective DB from personal backups by default (see scripts/backup.sh)
EXCLUDE_COLLECTIVE_FROM_BACKUP=true

# ── Exoplanet tenant ───────────────────────────────────────────────────────────
EXOPLANET_TENANT_ID=exoplanet
EXOPLANET_TELEGRAM_BOT_TOKEN=
EXOPLANET_TELEGRAM_ALLOWED_USER_IDS=
EXOPLANET_TELEGRAM_MODE=polling
EXOPLANET_CACHE_DIR=/var/cache/platform/exoplanet
EXOPLANET_MAX_CACHE_GB=80
EXOPLANET_RETENTION_DAYS=30
EXOPLANET_MIN_PERIOD_DAYS=0.5
EXOPLANET_MAX_PERIOD_DAYS=20
EXOPLANET_SNR_THRESHOLD=5.0
EXOPLANET_LLM_SUMMARIES=false
EXOPLANET_LLM_MODEL=anthropic/claude-haiku-4.5
EXOPLANET_ALLOW_SYNTHETIC=true
EXOPLANET_FETCH_TPF=true
MAST_API_TOKEN=

# Scheduler profiles: demo, exoplanet, collective (comma-separated)
ENABLE_SCHEDULER_PROFILES=demo,exoplanet

# ── Traefik / TLS (production) ─────────────────────────────────────────────────
ACME_EMAIL=you@example.com
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD_HASH=

# ── Backups ────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
