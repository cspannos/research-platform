# Collective tenant secrets — copy to collective.env (gitignored).
# Use ONLY the anonymous GitHub account. Never reuse personal GitHub credentials.

COLLECTIVE_GITHUB_REPO=anon-user/collective-site
COLLECTIVE_GIT_USER_NAME=Your Pseudonym
COLLECTIVE_GIT_USER_EMAIL=12345678+anonuser@users.noreply.github.com

# Fine-grained PAT scoped to the anon repo (Contents: read/write)
COLLECTIVE_GITHUB_TOKEN=

# Set true only after reviewing opsec checklist in README
COLLECTIVE_PUBLISH_ENABLED=false

# Optional: separate LLM key to avoid billing correlation with personal tenants
COLLECTIVE_OPENROUTER_API_KEY=
